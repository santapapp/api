APP_NAME="Santap API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
SCRAMBLE_DOCS_ENABLED=false
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

SANTAP_API_VERSION=v1
SANTAP_DEFAULT_COUNTRY=ID
SANTAP_DEFAULT_CURRENCY=IDR
SANTAP_DEFAULT_TIMEZONE=Asia/Jakarta
SANTAP_CUSTOMER_SESSION_TTL_MINUTES=720

# Integrasi pembayaran QRIS (bridge Sekeco → Midtrans)
QRIS_BASE_URL=https://qris.sekeco.id
# Window pembayaran QRIS (menit) sebelum order dianggap timeout.
# Diset mendekati expiry_time Midtrans (~15 menit) agar tidak ada false-expire.
QRIS_EXPIRY_MINUTES=15

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=santap
DB_USERNAME=sail
DB_PASSWORD=password

# PostgreSQL / Neon example:
# DB_CONNECTION=pgsql
# DB_URL=postgresql://user:password@host/dbname?sslmode=require
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@santap.app"
MAIL_FROM_NAME="${APP_NAME}"

HORIZON_NAME="${APP_NAME}"
HORIZON_PATH=horizon

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANTAP_WEB_URL=https://santap.app

WWWGROUP=1000
WWWUSER=1000
